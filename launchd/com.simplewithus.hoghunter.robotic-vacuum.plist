<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.simplewithus.hoghunter.robotic-vacuum</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>__HOGHUNTER_REPO__/scripts/robotic-vacuum.py</string>
		<string>--tick</string>
		<string>scheduler</string>
	</array>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/HogHunter/robotic-vacuum.out.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/HogHunter/robotic-vacuum.err.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:__HOME__/.local/bin</string>
		<key>JANITOR_MAX_LOAD</key>
		<string>250</string>
	</dict>
</dict>
</plist>
