<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Hog Hunter looks for your Mac on this Wi-Fi to monitor activity, tame or quit busy apps, and safely clean disk clutter when enabled.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_hoghunter._tcp</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Sentry DSN, injected at build time from the SENTRY_DSN environment.
	     Empty unless the TestFlight archive passes the secret, which keeps
	     SentryTelemetry a no-op. -->
	<key>SentryDSN</key>
	<string>$(SENTRY_DSN)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.simplewithus.hoghunter.ios</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>hoghunter</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
