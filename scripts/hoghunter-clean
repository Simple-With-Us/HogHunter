#!/usr/bin/env python3
"""
hoghunter-clean — Hog Hunter's reclaim engine.

This engine is the Mac's cleanup driver: it does the app-cache deletes a
junk cleaner does *and* the things one cannot do for this Mac:

  SHRINK   APFS local snapshots, SQLite -wal files, unbounded logs
  DELETE   fleet-specific regenerable staging (BotFleet, ShipIt, Sparkle,
           mktemp `ssr` nests, simulator runtimes, device support)
  REPORT   ask-first inventory, duplicates — surfaced, never auto-applied

The CleanMyMac CLI (MacPaw's free public beta, closed-source, never vendored)
stays an opt-in extra: `--cleanmymac` runs its non-interactive sweeps
(`clean junk --force`, `optimize purgeable`) after this engine's own work,
and only when the CLI is installed.  Without the flag it is never invoked.

Every rule encodes a lesson from BF-HOUSEKEEPER's wake log; see
config/reclaim-policy.json for the machine-readable version of the same
policy.  This file and that JSON are the single source of truth shared with
the Hog Hunter GUI (Sources/Storage/DiskCleaner.swift).

Usage
  hoghunter-clean --scan                 read-only, print plan
  hoghunter-clean --clean                apply the safe tier
  hoghunter-clean --clean --band=full   also apply semi-safe tier
  hoghunter-clean --clean --budget-sec=600   stop starting work after 10 minutes
  hoghunter-clean --clean --cleanmymac  also run the CleanMyMac CLI sweeps
  hoghunter-clean --scan --categories=snapshots,logs --json

Modes are mutually exclusive with --categories=... --policy to see everything.
"""
from __future__ import annotations

import argparse
import json
import os
import plistlib
import re
import shutil
import sqlite3
import subprocess
import sys
import time
from dataclasses import dataclass, field, asdict
from pathlib import Path
from typing import Callable, Iterable, Sequence

# --------------------------------------------------------------------------
# Constants and machine facts
# --------------------------------------------------------------------------

VERSION = "1.0.0"
HOME = Path.home()

# Disk bands, in GiB free.  Acute = reclaim urgently; critical = tell Jay.
DISK_CRITICAL_GB = 25.0
DISK_ACUTE_GB = 40.0
DISK_HEALTHY_GB = 80.0

# Pressure gates.  OWNER RULING 2026-10-02: pressure changes the SHAPE of the
# work, never its SCOPE.  The old rule ("swap >= 90 OR load1 > 40 => do less")
# was a guard whose threshold sat INSIDE this host's normal operating band --
# load1 runs 15-30 here continuously from real fleet build work -- so it was
# true nearly always, and wedded to a near-permanent swap reading it meant
# cleaning almost never ran.  A guard whose threshold equals the normal state
# is an outage, not a guard.  Same defect class as the disk janitor's binary
# pressure gate, diagnosed 2026-10-02.
#
# What is still true, and what these numbers are FOR: deleting caches never
# reduces swap, so pressure governs how we sequence the work (chunk size,
# spacing) and which *tier* of risk we open -- not whether we clean at all.
SWAP_CRIT_PCT = 90.0
# Retained for reporting and for the expensive-tier gate only.  It must NEVER
# be a reason to skip work: on this Mac it is true nearly always.
LOAD_CRIT = 40.0

# Chunking under pressure.  Target how many candidates to apply per batch and
# how long to pause between batches so the host gets breathing room while the
# deletes land.  A chunk is deliberately small: 2-3 targets, measured working
# 2026-10-02 21:24 (3 chunks, ~1.9G by du, load1 25.7 -> 15.1, zero kills).
CHUNK_TARGETS = 3
CHUNK_PAUSE_SEC = 5.0
# Above this load the chunks get smaller and the pauses get longer rather than
# the work being skipped.  Still not a skip.
CHUNK_LOAD_HIGH = 40.0
# Idle-percent floor below which we pause longer between chunks.  Read
# together with load1 and kernel_task: high load with HIGH idle is real work
# (keep going), high load with LOW idle is thrash (back off the burst).
CHUNK_IDLE_LOW_PCT = 12.0

# How the chunks are cut.  The ruling above is "divide the work into 2-4 smaller tasks", so a chunk is a slot
# of work, not a file.  A heavy candidate (a tree, a snapshot, a WAL, a brew run) takes a whole slot.  A light
# one (a file or small tree under LIGHT_CANDIDATE_BYTES) takes 1/LIGHT_PER_SLOT of a slot, so 1,710 per-run marker
# files are 3 chunks of 600, not 570 chunks with a 5 to 20 s sleep after each.  Counting files made one sweep
# run past an hour while the Robotic Vacuum killed it at 900 s every time (Oct 9 2026), so nothing was freed.
LIGHT_CANDIDATE_BYTES = 8 * 1024 * 1024
LIGHT_PER_SLOT = 200

# What proc_count answers when pgrep itself failed.  A failed look is not an empty room: the callers read any
# non-zero count as "busy", so a timeout under load 600 skips the work instead of running it blind.
PROBE_FAILED = 10 ** 6

# Idle gates.  "No file touched in N minutes" proves nothing is mid-write.
IDLE_MIN_OK = 90
IDLE_MIN_SCRATCH = 180   # 3h for temp scratch
IDLE_MIN_STAGING = 60    # 1h for app-update staging
IDLE_MIN_ROLLBACK = 1440  # 24h for abandoned update/rollback copies
IDLE_MIN_BUILD_OUTPUT = 7 * 24 * 60  # 7d for regenerable build output in main checkouts

# Per-rule wall clock.  A scan that takes longer than the pressure it is
# responding to is worse than no scan: under load 500+ a TMPDIR or ~/Code
# walk runs for minutes.  Every tree-walking rule takes a partial result
# rather than blocking the caller.
RULE_BUDGET_SEC = 90

POLICY_PATH = Path(__file__).resolve().parent.parent / "config" / "reclaim-policy.json"

# Ask-first items are the biggest trees on the Mac.  Sizing them costs a full
# walk that can run for minutes under load, and their gate is a human
# decision rather than a byte count -- so skip sizing unless asked.
SIZE_ASK_FIRST = False
CLEAN_IOS27 = False

# Never touch these, no matter what a scan finds.  Data, not waste.
FORBIDDEN_PREFIXES = (
    str(HOME / "Library/CloudStorage"),
    str(HOME / "Documents"),
    str(HOME / "Pictures"),
    str(HOME / "Movies"),
    str(HOME / "Desktop"),
    str(HOME / "Desktop"),
    str(HOME / "Library/Developer/CoreSimulator/Devices"),
    str(HOME / ".grok/worktrees"),
)
KEEP_SENTINEL = ".janitor-keep"
# APFS system volume + sealed paths.  Deleting any of these bricks the Mac.
FORBIDDEN_EXACT = (
    "/System", "/Library", "/private/var/db", "/private/var/folders/zz",
    "/usr", "/bin", "/sbin", "/opt/homebrew", "/Applications",
)


def log(msg: str) -> None:
    print(f"[hoghunter-clean] {msg}", file=sys.stderr, flush=True)


# --------------------------------------------------------------------------
# Time budget
#
# `--budget-sec N` is how a caller with its own deadline (the Robotic Vacuum
# gives this engine 10 minutes of its 15) gets a finished, honest report
# instead of a kill.  The clock starts when main() starts, so the scan counts.
# Nothing is lost when the budget runs out: the next run rescans, what was
# removed is gone, and the rest is the new list.  No flag means no limit.
#
# The scan does NOT get the whole budget.  The scan is the part that gets
# slower as the host gets busier, and a scan that eats the whole budget
# leaves the apply phase with nothing: no file is deleted, and the next run
# rescans the same tree and eats the budget again.  That is a livelock, not
# progress.  Measured 2026-10-19: a 900 s budget went entirely to the scan,
# 1 of 23 candidates was applied, and the run ended with
# `budget_exhausted=True` and zero bytes freed -- on the very run meant to
# free the disk.  So the scan gets a fixed share and the rest is reserved
# for the deletes.
# --------------------------------------------------------------------------

# The scan's share of the budget.  The remaining 40% belongs to the deletes.
SCAN_BUDGET_FRACTION = 0.6

_DEADLINE: float | None = None
_SCAN_DEADLINE: float | None = None
_SCAN_BUDGET_EXHAUSTED = False


def set_budget(seconds: float) -> None:
    """Start the clock.  Zero or less clears any budget."""
    global _DEADLINE, _SCAN_DEADLINE, _SCAN_BUDGET_EXHAUSTED
    if seconds and seconds > 0:
        now = time.monotonic()
        _DEADLINE = now + seconds
        _SCAN_DEADLINE = now + seconds * SCAN_BUDGET_FRACTION
    else:
        _DEADLINE = None
        _SCAN_DEADLINE = None
    _SCAN_BUDGET_EXHAUSTED = False


def budget_left() -> float:
    """Seconds left in the budget, or infinity when there is none."""
    if _DEADLINE is None:
        return float("inf")
    return max(0.0, _DEADLINE - time.monotonic())


def scan_budget_left() -> float:
    """Seconds left for the SCAN alone, or infinity when there is no budget.

    The scan stops at its own deadline so the deletes always get the rest of
    the budget.  A scan that runs out of time is not a failure: it returns
    what it found, and the apply phase deletes it."""
    if _SCAN_DEADLINE is None:
        return float("inf")
    return max(0.0, _SCAN_DEADLINE - time.monotonic())


# A heavy candidate (a tree, a snapshot, a brew run) is not started with less than this left.  Starting
# `brew cleanup` with 5 s in hand and killing it half done helps nobody; the next run starts it with a fresh budget.
MIN_HEAVY_START_SEC = 30.0


def op_timeout(default: float) -> float:
    """The timeout for one apply-time command: its usual limit, cut to what is left of the budget (never under
    5 s).  Every subprocess an apply step starts takes its timeout from here, so none can run past the budget by
    more than a few seconds and into the caller's hard stop."""
    return min(float(default), max(5.0, budget_left()))


# --------------------------------------------------------------------------
# Result types
# --------------------------------------------------------------------------

@dataclass
class Candidate:
    """One reclaimable thing found by a rule."""
    category: str
    path: str
    bytes: int
    reason: str
    tier: str = "safe"          # safe | semi-safe | ask-first
    op: str = "delete"          # delete | truncate | wal-checkpoint | snapshot-delete
    detail: str = ""
    applied: bool = False
    error: str = ""

    @property
    def mib(self) -> float:
        return self.bytes / (1024 * 1024)

    def as_dict(self) -> dict:
        d = asdict(self)
        d["mib"] = round(self.mib, 1)
        return d


@dataclass
class Band:
    """Current resource pressure.

    `chunk_size` / `chunk_pause_sec` are how pressure shapes the work.
    `cheap_only` is retained as a REPORTING field and as the expensive-tier
    gate; it is never a reason to skip the safe or semi-safe tiers.
    """
    disk_free_gb: float
    disk_used_pct: float
    swap_used_pct: float
    load1: float
    # Retained for compatibility and reporting.  See the OWNER RULING note at
    # SWAP_CRIT_PCT: pressure must not suppress work, so this no longer gates
    # the safe or semi-safe tiers.
    cheap_only: bool
    reasons: list[str] = field(default_factory=list)
    # Added 2026-10-02.  High load1 alone does not mean thrash.
    cpu_idle_pct: float = 0.0
    kernel_task_pct: float = 0.0
    chunk_size: int = CHUNK_TARGETS
    chunk_pause_sec: float = CHUNK_PAUSE_SEC
    throttling: bool = False

    @property
    def disk_band(self) -> str:
        if self.disk_free_gb < DISK_CRITICAL_GB:
            return "critical"
        if self.disk_free_gb < DISK_ACUTE_GB:
            return "acute"
        if self.disk_free_gb < DISK_HEALTHY_GB:
            return "ok"
        return "healthy"

    @property
    def is_thrashing(self) -> bool:
        """True only when the host is genuinely paging, not merely busy.

        load1 counts uninterruptible page-in as running, so it is a LAGGING
        indicator.  2026-10-02 21:00: load1 25.68 with 27% idle and kernel_task
        absent from the top-CPU sample was real fleet work, not thrash.
        """
        return self.cpu_idle_pct < CHUNK_IDLE_LOW_PCT

    @property
    def pressure_label(self) -> str:
        if self.is_thrashing:
            return "throttling"
        if self.swap_used_pct >= SWAP_CRIT_PCT or self.load1 > CHUNK_LOAD_HIGH:
            return "elevated (chunked)"
        return "calm"

    def as_dict(self) -> dict:
        d = asdict(self)
        d["disk_band"] = self.disk_band
        d["is_thrashing"] = self.is_thrashing
        d["pressure_label"] = self.pressure_label
        return d


def _run(cmd: Sequence[str], timeout: int = 20) -> str:
    """Run a command, return stdout.  Never raises."""
    try:
        p = subprocess.run(list(cmd), capture_output=True, text=True, timeout=timeout)
        return p.stdout if p.returncode == 0 else ""
    except (subprocess.TimeoutExpired, OSError):
        return ""


# --------------------------------------------------------------------------
# CleanMyMac CLI -- opt-in extra, never a dependency.  The CLI is MacPaw's
# closed-source free public beta: it is invoked when installed, never
# vendored.  Only its non-interactive sweeps run here (`clean junk --force`
# skips the review step by MacPaw's own flag; `optimize purgeable` has no
# review step).  Interactive-only commands (`purge`, `analyze`, the per-item
# review) are deliberately out.  Mirrors VacuumEngine._cleanmymac_cli in
# scripts/vacuum/engine.py; keep the two command lists in sync.
# --------------------------------------------------------------------------

CLEANMYMAC_COMMANDS: tuple[tuple[str, ...], ...] = (
    ("cleanmymac", "clean", "junk", "--force"),
    ("cleanmymac", "optimize", "purgeable"),
)
CLEANMYMAC_TIMEOUT_SEC = 600


def run_cleanmymac_cli(report: dict, budget_sec: float = 0.0) -> None:
    """Run the CleanMyMac sweeps, recording each into report.  Never raises and
    never fails the caller: a missing CLI, a spent budget, a timeout, or a
    non-zero exit is recorded in the report and logged, and the run continues
    with exit 0.  Fills report keys: installed, ran, commands, skipped."""
    if budget_sec > 0 and budget_left() < MIN_HEAVY_START_SEC:
        report["skipped"] = "budget spent"
        log("cleanmymac: budget spent; skipping sweeps")
        return
    if shutil.which("cleanmymac") is None:
        report["installed"] = False
        report["skipped"] = "cleanmymac CLI not installed"
        log("cleanmymac CLI not installed; skipping (--cleanmymac)")
        return
    report["installed"] = True
    try:
        version = subprocess.run(
            ["cleanmymac", "--version"], capture_output=True, text=True, timeout=20
        )
        report["version"] = (version.stdout or version.stderr or "").strip()[:80]
    except (subprocess.TimeoutExpired, OSError):
        report["version"] = ""
    for argv in CLEANMYMAC_COMMANDS:
        if budget_sec > 0 and budget_left() < MIN_HEAVY_START_SEC:
            report["skipped"] = "budget spent"
            log("cleanmymac: budget spent; skipping remaining sweeps")
            return
        timeout = CLEANMYMAC_TIMEOUT_SEC
        if budget_sec > 0:
            timeout = int(max(MIN_HEAVY_START_SEC, min(CLEANMYMAC_TIMEOUT_SEC, budget_left())))
        try:
            p = subprocess.run(list(argv), capture_output=True, text=True, timeout=timeout)
            tail = [ln for ln in ((p.stdout or "") + "\n" + (p.stderr or "")).splitlines() if ln.strip()]
            entry = {"argv": list(argv), "exit": p.returncode, "tail": tail[-3:] if tail else []}
            log(f"cleanmymac {' '.join(argv[1:])}: exit {p.returncode}")
        except subprocess.TimeoutExpired:
            entry = {"argv": list(argv), "exit": "timeout", "tail": [f"no finish within {timeout}s"]}
            log(f"cleanmymac {' '.join(argv[1:])}: timed out after {timeout}s")
        except OSError as exc:
            entry = {"argv": list(argv), "exit": "error", "tail": [f"{type(exc).__name__}: {exc}"[:200]]}
            log(f"cleanmymac {' '.join(argv[1:])}: {exc}")
        report["commands"].append(entry)
    report["ran"] = True


# --------------------------------------------------------------------------
# Safety primitives -- the lessons that keep this from eating Jay's data
# --------------------------------------------------------------------------

def is_forbidden(path: str) -> bool:
    """True when policy forbids touching this path outright."""
    p = str(Path(path).expanduser())
    for exact in FORBIDDEN_EXACT:
        if p == exact or p.startswith(exact + "/"):
            return True
    for pre in FORBIDDEN_PREFIXES:
        if p == pre or p.startswith(pre + "/"):
            return True
    return False


def has_keep_sentinel(path: str) -> bool:
    """`.janitor-keep` anywhere in the subtree means hands off."""
    p = Path(path)
    if (p / KEEP_SENTINEL).exists():
        return True
    # A sentinel on any parent also protects the child.
    for parent in p.parents:
        if (parent / KEEP_SENTINEL).exists():
            return True
    return False


# One system-wide lsof pass answers "is this path in use" for every candidate
# at once.  The old shape asked lsof about each path separately, and lsof on
# a loaded Mac times out at 25s.  With hundreds of candidates that is hours of
# blocked scanning, and a scan that never reaches a decision deletes nothing:
# the safe tier found 41.9 MB across 915 items and freed nothing else.  One
# snapshot turns that per-path cost into a single bounded one.
_OPEN_SNAPSHOT: set[str] | None = None
_OPEN_SNAPSHOT_AT: float = 0.0
# A scan may run for the whole 600s budget, and the per-path lsof this snapshot
# replaced evaluated each candidate as it went.  A snapshot kept for the whole
# process would answer for a candidate examined ten minutes after the listing
# was taken, so a file opened in between reads as absent.  Retake it past this
# age; 60s keeps the pass bounded without making the answer meaningfully stale.
_OPEN_SNAPSHOT_MAX_AGE_SEC = 60.0


def _load_open_snapshot() -> set[str] | None:
    """Every path lsof reports open, or None when the answer is untrustworthy.

    The name list is read with the cwd of each process so that a relative
    name can be resolved: lsof prints "./thing" for a file opened relative to
    a working directory, and an unresolved relative name would silently hide
    an open handle.

    Names are canonicalised on the way in.  lsof answers with resolved vnode
    paths, so a file under the per-user TMPDIR arrives as /private/var/...
    while the candidate the rule built is /var/... (`getconf
    DARWIN_USER_TEMP_DIR` hands back the symlink).  Matching the two by string
    would read every open handle in TMPDIR as absent.
    """
    global _OPEN_SNAPSHOT, _OPEN_SNAPSHOT_AT
    if _OPEN_SNAPSHOT is not None and time.monotonic() - _OPEN_SNAPSHOT_AT < _OPEN_SNAPSHOT_MAX_AGE_SEC:
        return _OPEN_SNAPSHOT
    try:
        p = subprocess.run(["/usr/sbin/lsof", "-F", "pfn"], capture_output=True, text=True, timeout=180)
    except (subprocess.TimeoutExpired, OSError) as exc:
        log(f"system-wide lsof did not answer ({type(exc).__name__}); using per-path checks")
        return None
    if p.returncode != 0:
        # A lsof that exited badly can still have printed part of its listing.
        # Caching a partial set would read every file it failed to mention as
        # closed, and the "no open handles" gate would pass on a directory a
        # live process is holding.  Fall back to the per-path check instead.
        log(f"system-wide lsof exited {p.returncode}; treating the snapshot as untrustworthy")
        return None
    cwd_by_pid: dict[str, str] = {}
    paths: set[str] = set()
    pid = ""
    want_cwd = False
    for ln in p.stdout.splitlines():
        if not ln:
            continue
        tag, body = ln[0], ln[1:]
        if tag == "p":
            pid = body
        elif tag == "f":
            want_cwd = body in ("cwd", "rtd") and bool(pid)
        elif tag == "n":
            name = body
            if name.endswith(" (deleted)"):
                name = name[: -len(" (deleted)")]
            if want_cwd and pid:
                # The name line that follows an fcwd/frtd line IS the working
                # directory, and it is what a relative name resolves against.
                cwd_by_pid[pid] = name
            want_cwd = False
            if name and not name.startswith("/"):
                base = cwd_by_pid.get(pid)
                if base:
                    name = os.path.join(base, name)
            if name.startswith("/"):
                paths.add(os.path.realpath(name))
    if not paths:
        # lsof answered but found nothing at all, which on a live Mac is not
        # believable.  Treat it as untrustworthy rather than as "nothing open".
        log("system-wide lsof returned no paths; treating the snapshot as untrustworthy")
        return None
    # Stamp the age only once the listing has actually passed every gate
    # above.  Stamping it before the lsof pass would start the clock while a
    # listing that took longer than the max age to produce is still forming,
    # so that listing arrives already stale and the next candidate pays for
    # another system-wide lsof.
    _OPEN_SNAPSHOT_AT = time.monotonic()
    _OPEN_SNAPSHOT = paths
    return _OPEN_SNAPSHOT


def open_handles(path: str) -> int:
    """Count processes with this exact path open.

    Housekeeper rule: `lsof +D` HANGS on big trees -- never use it.  Ask
    lsof about the exact path instead.

    The answer comes from one system-wide lsof snapshot when that snapshot is
    available, so the cost is one bounded pass rather than one timeout per
    candidate.  A snapshot that could not be taken falls back to the old
    per-path lsof.

    A look that failed is not an empty room.  A per-path lsof that times out
    (it does, under load 600) or cannot run counts as one open handle, so the
    caller leaves the path alone.  lsof exits 1 for "nothing found", so the
    exit code does not decide it: the pids on stdout do.
    """
    snapshot = _load_open_snapshot()
    if snapshot is not None:
        # Canonicalised for the same reason the snapshot is: the candidate may
        # be spelled through a symlink (/var, /tmp) and the handle it names is
        # not, and a mismatch here reads as "nothing holds this open".
        target = os.path.realpath(str(path)).rstrip("/")
        prefix = target + "/"
        return sum(1 for n in snapshot if n == target or n.startswith(prefix))
    try:
        p = subprocess.run(["/usr/sbin/lsof", "-F", "p", "--", str(path)],
                           capture_output=True, text=True, timeout=25)
    except (subprocess.TimeoutExpired, OSError):
        log(f"lsof could not look at {path!r}; treating it as open")
        return 1
    pids = {ln for ln in p.stdout.splitlines() if ln.startswith("p")}
    if not pids and p.returncode not in (0, 1):
        log(f"lsof exited {p.returncode} for {path!r}; treating it as open")
        return 1
    return len(pids)


def touched_since(path: str, days: float) -> bool:
    """True when any file under path is newer than `days` days.

    `newest_file_age_min` caps its walk, so a huge tree can hide a recent file
    past the cap and read as idle.  find with -quit answers on the FIRST recent
    file instead, which is fast exactly when it matters (an active tree), and
    only walks everything when the tree is genuinely quiet.  A failed look
    reads as touched: an unprovable tree is never called idle.

    The cutoff is expressed in whole MINUTES, not fractional days.  A day is
    a whole unit to find's date parser and 90 minutes is not: `IDLE_MIN_OK`
    arrives here as 0.0625 days, and both GNU and BSD find refuse "-0.0625
    days" outright.  find then exits non-zero, this fails closed to "touched",
    and the idle gate rejects every candidate -- so the rule silently frees
    nothing, with no error anywhere to say why.  Minutes parse on both.
    """
    try:
        proc = subprocess.run(
            ["find", path, "-type", "f", "-newermt", f"-{days * 24 * 60:g} minutes", "-print", "-quit"],
            capture_output=True, text=True, timeout=120,
        )
    except (subprocess.TimeoutExpired, OSError, ValueError):
        return True
    if proc.returncode != 0:
        return True
    return bool(proc.stdout.strip())


def newest_file_age_min(path: str, max_entries: int = 4000) -> float:
    """Age in minutes of the newest file under path.

    0.0 means "something was written just now" -- the thing is live.
    Returns a very large number for a missing/empty path so callers can treat
    "nothing here" as "safely idle".
    """
    p = Path(path)
    if not p.exists():
        return 1e9
    if p.is_file():
        return (time.time() - p.stat().st_mtime) / 60.0
    newest = 0.0
    seen = 0
    stack = [p]
    while stack and seen < max_entries:
        cur = stack.pop()
        try:
            st = cur.lstat()
        except OSError:
            continue
        if cur.is_symlink():
            continue
        if cur.is_dir():
            try:
                stack.extend(cur.iterdir())
            except OSError:
                pass
        else:
            newest = max(newest, st.st_mtime)
            seen += 1
    if newest == 0.0:
        return 1e9
    return (time.time() - newest) / 60.0


def proc_count(pattern: str) -> int:
    """Count running processes matching a regex against argv.

    Never `ps`/`pgrep -l`/`pgrep -fl` -- argv on this Mac carries live API
    keys and lands them in logs.  Count only.

    pgrep exits 1 for "no match".  Any other outcome (a timeout, a missing
    binary, another exit code) returns PROBE_FAILED, which every caller reads
    as busy.  Reading a failed look as "nothing running" would let the dev
    caches and Xcode artifacts go while a build runs.
    """
    try:
        p = subprocess.run(["/usr/bin/pgrep", "-f", pattern],
                           capture_output=True, text=True, timeout=15)
    except (subprocess.TimeoutExpired, OSError):
        log(f"pgrep {pattern!r} failed; treating it as busy")
        return PROBE_FAILED
    if p.returncode == 1:
        return 0
    if p.returncode != 0:
        log(f"pgrep {pattern!r} exited {p.returncode}; treating it as busy")
        return PROBE_FAILED
    return len([ln for ln in p.stdout.splitlines() if ln.strip()])


def dir_bytes(path: str, max_depth: int = 8, deadline_cap: float | None = None) -> int:
    """Bytes under a path, bounded by depth and time, without following symlinks.

    deadline_cap is the wall clock this walk may not pass.  During a scan it
    is the SCAN deadline, so one huge tree cannot spend the budget the
    deletes need; the apply phase passes the full budget instead.  With no
    cap (no budget at all) the walk is bounded only by RULE_BUDGET_SEC."""
    global _SCAN_BUDGET_EXHAUSTED
    p = Path(path)
    if not p.exists():
        return 0
    if p.is_file() and not p.is_symlink():
        try:
            return p.stat().st_size
        except OSError:
            return 0
    total = 0
    started = time.monotonic()
    deadline = started + RULE_BUDGET_SEC
    cap = deadline_cap if deadline_cap is not None else _SCAN_DEADLINE
    if cap is not None:
        deadline = min(deadline, cap)
    stack = [(p, 0)]
    while stack:
        now = time.monotonic()
        if now >= deadline:
            if cap is not None and now >= cap:
                _SCAN_BUDGET_EXHAUSTED = True
            break
        cur, depth = stack.pop()
        try:
            if cur.is_symlink():
                continue
            if cur.is_file():
                total += cur.stat().st_size
                continue
            if not cur.is_dir():
                continue
        except OSError:
            continue
        if depth > max_depth:
            # Deep tree: size it once, without also queueing its descendants.
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                if cap is not None and time.monotonic() >= cap:
                    _SCAN_BUDGET_EXHAUSTED = True
                break
            du = _run(["/usr/bin/du", "-sk", str(cur)], timeout=min(30.0, remaining))
            try:
                total += int(du.split()[0]) * 1024
            except (IndexError, ValueError):
                pass
            if cap is not None and time.monotonic() >= cap:
                _SCAN_BUDGET_EXHAUSTED = True
                break
            continue
        try:
            for child in cur.iterdir():
                now = time.monotonic()
                if now >= deadline:
                    if cap is not None and now >= cap:
                        _SCAN_BUDGET_EXHAUSTED = True
                    break
                stack.append((child, depth + 1))
        except OSError:
            continue
    return total


# --------------------------------------------------------------------------
# Apply operations
#
# `rm -rf` is intercepted by the mavis-trash layer on this Mac: it reports
# success, removes the inodes, and moves the bytes to ~/.Trash, freeing
# NOTHING.  Every delete below goes through `find -depth -delete` and the
# result is verified against a fresh df by the caller, never the exit code.
# --------------------------------------------------------------------------

def apply_delete(path: str, known_bytes: int | None = None) -> tuple[int, str]:
    """Delete a file or tree for real.  Returns (bytes_freed, error).

    known_bytes is the size the scan already measured; passing it spares a second walk of a big tree.  The
    delete never outlives the run's budget by more than a few seconds."""
    p = Path(path)
    if is_forbidden(path):
        return 0, "forbidden path"
    if has_keep_sentinel(path):
        return 0, f"{KEEP_SENTINEL} sentinel present"
    if not p.exists():
        return 0, ""
    before = known_bytes if known_bytes is not None else dir_bytes(path, deadline_cap=_DEADLINE)
    try:
        if p.is_dir() and not p.is_symlink():
            # -depth so children go before parents; -delete removes empty
            # dirs.  Do NOT use `rm -rf` -- mavis-trash swallows it.
            subprocess.run(
                ["/usr/bin/find", str(p), "-depth", "-delete"],
                capture_output=True, timeout=op_timeout(600),
            )
        else:
            p.unlink()
    except (OSError, subprocess.SubprocessError) as exc:
        return 0, f"{type(exc).__name__}: {exc}"
    if p.exists():
        return 0, "path still present after delete"
    return before, ""


def apply_truncate(path: str, keep_mib: int) -> tuple[int, str]:
    """Keep the LAST keep_mib of a log and drop the prefix.

    Tail-truncation is the right shrink for append-only logs: the recent
    lines are the useful ones and the reader is almost always following the
    tail.  No data the operator can act on is lost.
    """
    p = Path(path)
    if is_forbidden(path) or has_keep_sentinel(path) or not p.is_file():
        return 0, "not a trimmable file"
    try:
        size = p.stat().st_size
        keep = keep_mib * 1024 * 1024
        if size <= keep:
            return 0, ""
        with p.open("r+b") as fh:
            fh.seek(size - keep)
            tail = fh.read()
            nl = tail.find(b"\n")
            tail = tail[nl + 1:] if nl != -1 else tail
            fh.seek(0)
            fh.write(tail)
            fh.truncate()
    except OSError as exc:
        return 0, f"{type(exc).__name__}: {exc}"
    return size - p.stat().st_size, ""


def apply_wal_checkpoint(db: str) -> tuple[int, str]:
    """TRUNCATE a SQLite write-ahead log.

    A large -wal next to a live DB is pure double-storage.  A checkpoint
    TRUNCATE folds it back into the main file and zeroes the WAL.  Unlike
    VACUUM this is a constant-time, non-rewriting operation, so it is safe
    on a 14 GB database -- it just moves pages that are already accounted
    for.  Blocked if another process holds the DB; we refuse rather than
    wait.
    """
    wal = Path(db + "-wal")
    if not wal.is_file():
        return 0, ""
    before = wal.stat().st_size
    if before < 8 * 1024 * 1024:
        return 0, "wal under 8M"
    if open_handles(db):
        return 0, "database has open handles"
    try:
        con = sqlite3.connect(f"file:{db}?mode=rw", uri=True, timeout=2)
        con.execute("PRAGMA busy_timeout=2000")
        row = con.execute("PRAGMA wal_checkpoint(TRUNCATE)").fetchone()
        con.close()
    except sqlite3.Error as exc:
        return 0, f"sqlite: {exc}"
    except OSError as exc:
        return 0, f"{type(exc).__name__}: {exc}"
    after = wal.stat().st_size if wal.is_file() else 0
    if row and row[0] != 0:
        return 0, f"checkpoint busy (code {row[0]})"
    return max(0, before - after), ""


def snapshot_timestamp(name: str) -> str:
    """Convert a full APFS snapshot name into the bare stamp tmutil wants.

    `tmutil deletelocalsnapshots` takes a BARE timestamp.  Handed the full name
    "com.apple.TimeMachine.2026-09-30-045412.local" it treats the whole string
    as a disk and fails with "... is not a valid disk" (exit 22), which is
    silent unless you read stderr.  That broke the entire SHRINK tier on its
    headline operation -- measured 2026-09-30 as 17G free with two prunable
    snapshots sitting right there.

    Prefixes are stripped only on a match and the `.local` suffix only when
    present, so an already-bare timestamp passes through unchanged.
    """
    stamp = name
    for pre in ("com.apple.TimeMachine.", "com.apple.backup."):
        if stamp.startswith(pre):
            stamp = stamp[len(pre):]
            break
    if stamp.endswith(".local"):
        stamp = stamp[: -len(".local")]
    return stamp


def apply_snapshot_delete(name: str) -> tuple[int, str]:
    """Delete one APFS local snapshot.  Returns (0, note) -- size is unknown.

    `tmutil deletelocalsnapshots` never reports freed bytes, so the caller
    must measure df before/after rather than trusting this.  The snapshots
    themselves live on the destination disk, not here; what they consume is
    the Data volume's free space held against the container.
    """
    out = _run(["/usr/bin/tmutil", "deletelocalsnapshots",
                snapshot_timestamp(name)], timeout=op_timeout(120))
    if "Deleted local snapshot" in out or "Deleted snapshot" in out:
        return 0, ""
    remaining = _run(["/usr/bin/tmutil", "listlocalsnapshots", "/"], timeout=op_timeout(60))
    if name not in remaining:
        return 0, ""
    # Surface WHY.  A bare "delete did not take effect" cost a wake cycle on
    # 2026-09-30 because nothing in the output pointed at the argument format.
    detail = " ".join(out.split())[:200] or "no output"
    return 0, f"delete did not take effect: {detail}"


# --------------------------------------------------------------------------
# Rules -- each returns a list of Candidates
# --------------------------------------------------------------------------

def rule_snapshots() -> list[Candidate]:
    """APFS / Time Machine LOCAL snapshots.

    This is the single largest reclaim on a Mac that backs up to an external
    destination.  A local snapshot pins container space for as long as it
    exists, and the backup itself lives on the destination disk -- deleting a
    local snapshot does NOT touch the backup.  macOS recreates one on the
    next backup, so this is a shrink, not a loss.

    Keep the newest; prune the rest.  This is semi-safe: it is gated behind
    the full band.
    """
    out = _run(["/usr/bin/tmutil", "listlocalsnapshots", "/"], timeout=60)
    names = []
    for line in out.splitlines():
        line = line.strip()
        if line.endswith(".local") and line.startswith("com.apple."):
            names.append(line)
    # Newest first, by the timestamp embedded in the name.
    names.sort(reverse=True)
    cands = []
    for name in names[1:]:
        cands.append(Candidate(
            category="snapshots",
            path=f"apfs-snapshot:{name}",
            bytes=0,
            reason=f"local snapshot {name}, kept newest is {names[0]}",
            tier="semi-safe",
            op="snapshot-delete",
            detail="local snapshot only; the external backup is untouched",
        ))
    return cands


def rule_temp_scratch() -> list[Candidate]:
    """Orphaned mktemp scratch in the per-user TMPDIR.

    Classes are long-lived fleet artifacts: `ssr` nests (which sit under
    RANDOM-named parents, so they must be enumerated by depth, not by a
    top-level glob), vitest/agentic scratch, omb-api-test scratch, and the
    per-run `.com.openai.codex.*` marker files.

    Gate: nothing holds the directory AND nothing was written to it for 3h.
    """
    tmpdir = _run(["/usr/bin/getconf", "DARWIN_USER_TEMP_DIR"], timeout=10).strip()
    if not tmpdir:
        return []
    root = Path(tmpdir.rstrip("/"))
    if not root.is_dir():
        return []
    # Per-rule wall clock.  Under load 500+ a full TMPDIR walk can run for
    # minutes, and a scan that takes longer than the pressure it is
    # responding to is worse than no scan at all.  If the budget runs out we
    # return what we found rather than blocking the caller.
    deadline = time.time() + RULE_BUDGET_SEC
    cands: list[Candidate] = []
    seen: set[str] = set()

    # ssr nests can be at depth 1 or nested under a RANDOM-named parent at
    # depth 3, so a top-level `find -maxdepth 1 -name 'ssr-*'` misses them.
    # Enumerate by depth and filter on the `ssr/` leaf's own mtime.
    try:
        ssr_dirs = find_paths(
            [str(root), "-maxdepth", "3", "-type", "d", "-name", "ssr"],
            RULE_BUDGET_SEC,
        )
    except (OSError, subprocess.SubprocessError):
        ssr_dirs = []

    for d in ssr_dirs:
        if time.time() > deadline:
            log("temp-scratch: budget exhausted, returning partial results")
            break
        if d in seen or is_forbidden(d) or has_keep_sentinel(d):
            continue
        if newest_file_age_min(d) < IDLE_MIN_SCRATCH:
            continue
        if open_handles(d):
            continue
        seen.add(d)
        cands.append(Candidate(
            category="temp-scratch", path=d, bytes=dir_bytes(d),
            reason="orphaned ssr scratch, no handles, idle over 3h",
        ))

    for glob_pat, label in (
        ("agentic-vitest-*", "agentic-vitest scratch"),
        ("omb-api-test-*", "omb-api-test scratch"),
    ):
        for d in root.glob(glob_pat):
            if time.time() > deadline:
                log("temp-scratch: budget exhausted, returning partial results")
                break
            s = str(d)
            if s in seen or is_forbidden(s) or has_keep_sentinel(s):
                continue
            if newest_file_age_min(s) < IDLE_MIN_SCRATCH or open_handles(s):
                continue
            seen.add(s)
            cands.append(Candidate(
                category="temp-scratch", path=s, bytes=dir_bytes(s),
                reason=f"orphaned {label}, idle over 3h",
            ))

    # Codex per-run markers are FILES, not directories -- find -type d misses
    # them entirely and du -sh on each is wasted work.
    try:
        for f in find_paths(
            [str(root), "-maxdepth", "1", "-name", ".com.openai.codex.*"],
            60,
        ):
            if not f.strip() or f in seen:
                continue
            seen.add(f)
            cands.append(Candidate(
                category="temp-scratch", path=f, bytes=dir_bytes(f),
                reason="Codex per-run marker file (auto-rotated by Codex)",
            ))
    except (OSError, subprocess.SubprocessError):
        pass

    return cands


def rule_app_staging() -> list[Candidate]:
    """Downloaded updaters that were extracted but never swapped in.

    Sparkle/electron-updater leave a full extracted .app plus the source
    zip.  Gate on the owning updater process, NOT on lsof: an active
    ShipIt can report zero open handles while actively writing.
    """
    cands: list[Candidate] = []
    staging_globs = [
        (HOME / "Library/Caches/com.openai.codex/org.sparkle-project.Sparkle/Installation",
         "Codex Sparkle installation staging"),
        (HOME / "Library/Caches/com.anthropic.claudefordesktop.ShipIt",
         "Claude ShipIt staging"),
        (HOME / "Library/Caches/@mmx-agentelectron-updater", "MMX agent updater staging"),
        (HOME / "Library/Caches/ms-playwright", "Playwright browser downloads"),
    ]
    for path, label in staging_globs:
        p = Path(path)
        if not p.exists() or is_forbidden(str(p)) or has_keep_sentinel(str(p)):
            continue
        if newest_file_age_min(str(p)) < IDLE_MIN_STAGING:
            continue
        if open_handles(str(p)):
            continue
        # An updater that owns this path means it is mid-install.  Check the
        # process list for the product name, not just the generic name --
        # `ShipIt` on this Mac belongs to Grok Bot more often than to Claude.
        owner = re.sub(r"[^a-z]", "", Path(path).name.lower())[:8]
        if owner and proc_count(owner) > 0:
            continue
        cands.append(Candidate(
            category="app-staging", path=str(p), bytes=dir_bytes(str(p)),
            reason=f"{label}, idle, no owner process",
        ))
    return cands


def rule_botfleet_rollback() -> list[Candidate]:
    """Abandoned BotFleet server update/rollback copies.

    An update moves the running tree to `.botfleet-server.node_modules.rollback-<stamp>`
    and swaps in a fresh copy.  The rollback is regenerable (a reinstall rebuilds
    it: zero re-download penalty), but the first day is a grace period in case the
    new copy fails and the operator rolls back by hand.  Age is the younger of the
    newest file inside and the directory's own ctime: a moved-in old tree keeps its
    file mtimes, and only the move (which refreshes ctime) proves it just arrived.
    The live tree never matches:
    the glob needs the versioned `.node_modules.` infix with a suffix, and symlinks
    are skipped without following.
    """
    cands: list[Candidate] = []
    apps = HOME / "apps"
    if not apps.is_dir():
        return []
    now = time.time()
    for path in sorted(apps.glob(".botfleet-server.node_modules.*")):
        if path.is_symlink() or not path.is_dir():
            continue
        if is_forbidden(str(path)) or has_keep_sentinel(str(path)):
            continue
        try:
            moved_at = path.stat().st_ctime
        except OSError:
            continue
        if newest_file_age_min(str(path)) < IDLE_MIN_ROLLBACK:
            continue
        if (now - moved_at) / 60.0 < IDLE_MIN_ROLLBACK:
            continue
        if open_handles(str(path)):
            continue
        cands.append(Candidate(
            category="botfleet-rollback", path=str(path), bytes=dir_bytes(str(path)),
            reason="abandoned BotFleet update/rollback copy, idle 24h+, no open files",
        ))
    return cands


def rule_dev_caches() -> list[Candidate]:
    """Package-manager and toolchain download caches.

    All of these rebuild on next use.  pnpm and gradle are included only when
    no build is running, because on this Mac the build fan-out is what
    drives load and swap and disturbing it makes things worse.
    """
    if proc_count("xcodebuild") or proc_count("swift-frontend") or proc_count("clang"):
        return []  # real build in flight -- leave the caches it is using alone
    cands: list[Candidate] = []
    paths = [
        (HOME / "Library/Caches/node-gyp", "node-gyp headers"),
        (HOME / "Library/Caches/electron", "Electron downloads"),
        (HOME / "Library/Caches/electron-builder", "electron-builder cache"),
        (HOME / "Library/Caches/deno", "Deno downloads"),
        (HOME / "Library/Caches/copilot", "Copilot toolchain"),
        (HOME / "Library/Caches/org.swift.swiftpm", "SwiftPM artifacts"),
        (HOME / "Library/Caches/ms-playwright", "Playwright browsers"),
        (HOME / "Library/Caches/@mmx-agentelectron-updater", "MMX updater staging"),
        (HOME / ".npm/_cacache", "npm _cacache"),
        (HOME / ".cache/uv", "uv cache"),
        (HOME / ".cache/pip", "pip cache"),
        (HOME / ".yarn/cache", "Yarn cache"),
    ]
    building = proc_count("node ") + proc_count("tsc") > 20
    if not building:
        paths.append((HOME / "Library/pnpm/store", "pnpm store"))
    for path, label in paths:
        p = Path(path)
        if not p.exists() or is_forbidden(str(p)) or has_keep_sentinel(str(p)):
            continue
        if newest_file_age_min(str(p)) < IDLE_MIN_OK or open_handles(str(p)):
            continue
        size = dir_bytes(str(p))
        if size < 8 * 1024 * 1024:
            continue
        cands.append(Candidate(
            category="dev-caches", path=str(p), bytes=size,
            reason=f"{label}, idle, no open handles",
        ))
    return cands


def rule_xcode_artifacts() -> list[Candidate]:
    """Xcode build products and simulator runtimes.

    Simulator *runtimes* are regenerable and are historically the single
    biggest win on this Mac (18.5 GB measured 09-27).  Simulator *Devices*
    are NOT -- they hold user simulator state and are ask-first.
    """
    if proc_count("xcodebuild") or proc_count("clang") or proc_count("swift-frontend"):
        return []
    cands: list[Candidate] = []
    dd = HOME / "Library/Developer/Xcode/DerivedData"
    if dd.is_dir() and newest_file_age_min(str(dd)) > IDLE_MIN_OK:
        for d in dd.iterdir():
            if not d.is_dir() or has_keep_sentinel(str(d)):
                continue
            if newest_file_age_min(str(d)) < IDLE_MIN_OK or open_handles(str(d)):
                continue
            cands.append(Candidate(
                category="xcode-artifacts", path=str(d), bytes=dir_bytes(str(d)),
                reason="Xcode DerivedData project, no build running",
            ))
    support = HOME / "Library/Developer/Xcode/iOS DeviceSupport"
    if support.is_dir() and newest_file_age_min(str(support)) > 60 * 24 * 7:
        cands.append(Candidate(
            category="xcode-artifacts", path=str(support),
            bytes=dir_bytes(str(support)),
            reason="iOS DeviceSupport for OS versions older than 7d",
            tier="expensive",
            detail="re-downloads when an old device is attached",
        ))
    return cands


def rule_simulator_runtimes() -> list[Candidate]:
    """Installed iOS simulator runtimes.

    Large (18+ GB measured), fully re-downloadable from Xcode.  Deleting a
    runtime does not touch CoreSimulator/Devices, which stays ask-first.
    """
    if (proc_count("xcodebuild") or proc_count("Simulator") or
            proc_count("CoreSimulatorService") or proc_count("[Bb]itrig")):
        return []
    cands: list[Candidate] = []
    roots = [
        HOME / "Library/Developer/CoreSimulator/Profiles/Runtimes",
        Path("/Library/Developer/CoreSimulator/Profiles/Runtimes"),
    ]
    for root in roots:
        if not root.is_dir() or has_keep_sentinel(str(root)):
            continue
        for rt in root.iterdir():
            if not rt.is_dir() or is_forbidden(str(rt)):
                continue
            is_ios27 = bool(re.search(r"iOS[-_ ]?27", rt.name, re.I))
            if is_ios27 and not CLEAN_IOS27:
                continue
            if newest_file_age_min(str(rt)) < 60 * 48 or open_handles(str(rt)):
                continue
            cands.append(Candidate(
                category="simulator-runtimes", path=str(rt), bytes=dir_bytes(str(rt)),
                reason="iOS simulator runtime untouched for 48h+, re-downloadable",
                tier="expensive",
            ))
    return cands


def split_find_output(raw: bytes) -> list[str]:
    """Split `find -print0` output.  A newline inside a path is not a separator."""
    return [os.fsdecode(part) for part in raw.split(b"\0") if part]


def find_paths(args: list[str], timeout: float) -> list[str]:
    """Run find and return each path whole, including paths that contain newlines."""
    res = subprocess.run(
        ["/usr/bin/find", *args, "-print0"],
        capture_output=True,
        timeout=timeout,
    )
    if res.returncode != 0:
        # find exits non-zero when a directory is unreadable and still prints
        # the paths it could read.  Keep those paths.  A rejected primary must
        # not look like an empty tree.
        err = res.stderr.decode("utf-8", "replace").strip().replace("\n", " ")[:200]
        log(f"find exited {res.returncode}: {err}")
    return split_find_output(res.stdout)


def report_path(path: str) -> str:
    """One report line per path.  Newlines and terminal controls stay visible as text."""
    out: list[str] = []
    for ch in path:
        if ch == "\\":
            out.append("\\\\")
        elif ch == "\n":
            out.append("\\n")
        elif ch == "\r":
            out.append("\\r")
        elif ch < " " or ch == "\x7f":
            out.append(f"\\x{ord(ch):02x}")
        else:
            # Printable non-ASCII (caf\u00e9, \u65e5\u672c\u8a9e) passes through unchanged;
            # lone surrogates from os.fsdecode become visible \udcXX text instead
            # of raising UnicodeEncodeError on the way to stdout.
            out.append(ch.encode("utf-8", "backslashreplace").decode("utf-8"))
    return "".join(out)


def log_scan_roots() -> list[Path]:
    """Library logs and the housekeeper tree.  Repo checkouts are not logs."""
    return [
        HOME / "Library/Logs",
        HOME / ".botfleet",
    ]


def rule_unbounded_logs() -> list[Candidate]:
    """Log and JSONL files that grew without a rotation policy.

    The shrink operation: keep the tail, drop the prefix.  This is the case
    CleanMyMac's "delete logs" gets wrong -- deleting a live log file while a
    daemon holds the fd leaves the daemon writing to an unlinked inode, so the
    space is NOT freed until the daemon restarts.  Truncating in place fixes
    that, which is strictly better.
    """
    cands: list[Candidate] = []
    roots = log_scan_roots()
    keep_mib = 16
    deadline = time.time() + RULE_BUDGET_SEC
    for root in roots:
        if not root.is_dir():
            continue
        if time.time() > deadline:
            log("logs: budget exhausted, keeping partial results")
            break
        try:
            files = find_paths(
                [str(root), "-maxdepth", "3", "-type", "f",
                 "(", "-name", "*.log", "-o", "-name", "*.jsonl", "-o", "-name", "*.out",
                 "-o", "-name", "*.err", ")", "-size", "+64M"],
                RULE_BUDGET_SEC,
            )
        except (OSError, subprocess.SubprocessError):
            continue
        for f in files:
            if is_forbidden(f) or has_keep_sentinel(f):
                continue
            try:
                size = Path(f).stat().st_size
            except OSError:
                continue
            if size < 64 * 1024 * 1024:
                continue
            # A log being actively appended to is still safe to truncate in
            # place -- that is the point.  No lsof gate here.
            cands.append(Candidate(
                category="logs", path=f, bytes=size,
                reason=f"log grown to {size // (1024*1024)}M with no rotation",
                op="truncate",
                detail=f"keep last {keep_mib}M",
            ))
    return cands


def rule_sqlite_wals() -> list[Candidate]:
    """Oversized SQLite write-ahead logs next to a live database.

    Roots are deliberately narrow and shallow.  A `find` at depth 5 across
    ~/Library/Application Support is tens of thousands of inodes and, under
    load, runs for minutes -- which is the whole problem we are trying to fix.
    WAL files live one or two levels under an app's own directory, so depth 3
    finds them without the walk.
    """
    cands: list[Candidate] = []
    roots = [
        HOME / ".botfleet",
        HOME / "Library/Application Support/BotFleet",
        HOME / "Library/Application Support/HogHunter",
        HOME / "Library/Application Support/Simple-With-Us",
    ]
    for root in roots:
        if not root.is_dir() or is_forbidden(str(root)):
            continue
        try:
            files = find_paths(
                [str(root), "-maxdepth", "3", "-type", "f",
                 "-name", "*.db-wal", "-size", "+32M"],
                60,
            )
        except (OSError, subprocess.SubprocessError):
            continue
        for wal in files:
            db = wal[: -len("-wal")]
            if is_forbidden(wal) or has_keep_sentinel(wal):
                continue
            try:
                size = Path(wal).stat().st_size
            except OSError:
                continue
            cands.append(Candidate(
                category="sqlite-wal", path=db, bytes=size,
                reason=f"SQLite WAL at {size // (1024*1024)}M, no open handles",
                op="wal-checkpoint",
                detail="keep 16M",
            ))
    return cands


def rule_brew() -> list[Candidate]:
    """Old Homebrew formula versions and cached downloads."""
    if not shutil.which("brew"):
        return []
    if proc_count("brew") or proc_count("node-gyp"):
        return []
    out = _run(["/opt/homebrew/bin/brew", "cleanup", "--dry-run"], timeout=90)
    if not out:
        return []
    lines = [ln for ln in out.splitlines() if ln.strip() and "would remove" not in ln.lower()]
    if not lines:
        return []
    return [Candidate(
        category="brew", path="/opt/homebrew", bytes=0,
        reason=f"brew cleanup dry-run lists {len(lines)} obsolete entries",
        op="brew-cleanup",
        detail="aged + current symlinks retained by Homebrew",
    )]


def rule_ask_first_inventory() -> list[Candidate]:
    """The ask-first list, as a report.  NEVER applied.

    Surfaced so Jay (or the Housekeeper, with explicit OK) can act without
    re-deriving the inventory each time.

    Sizes are reported as 0 on purpose.  These are the largest trees on the
    Mac (DriveFS is multi-gigabyte, Devices holds simulator state) and sizing
    them costs a full walk that can run for minutes under load -- for a
    category whose gate is a human decision, not a byte count.  Pass
    --size-ask-first to opt into sizing.
    """
    cands: list[Candidate] = []
    size = dir_bytes if SIZE_ASK_FIRST else (lambda _p: 0)
    watch = [
        (HOME / "Library/Application Support/Google/DriveFS", "DriveFS local cache (content cache + Logs only; Resources are program files)"),
        (HOME / "Library/Developer/CoreSimulator/Devices", "Simulator devices (user simulator state)"),
        (HOME / ".grok/worktrees", "in-session Grok worktrees"),
    ]
    for path, label in watch:
        if path.exists():
            cands.append(Candidate(
                category="ask-first", path=str(path), bytes=size(str(path)),
                reason=label, tier="ask-first", op="report",
            ))
    # Claude VM bundles under any of the known roots.
    for root in (HOME / "Claude/vm_bundles", HOME / "Library/Application Support/Claude/vm_bundles"):
        if root.is_dir():
            for b in root.glob("*.bundle"):
                cands.append(Candidate(
                    category="ask-first", path=str(b), bytes=size(str(b)),
                    reason="Claude VM bundle (Monet / Parall)", tier="ask-first", op="report",
                ))
    # Orphaned Google Drive local copies, left behind when Drive for desktop is
    # disconnected and reconnected ("GoogleDrive-<account> (<date> <time>)").
    # Report only, never auto-delete: an orphan can hold files the live Drive
    # lacks.  The live folder ("GoogleDrive-<account>") has no " (" suffix, so
    # it never matches.  The date separator before AM/PM is a narrow no-break
    # space, so match on the parenthesis, never on a literal timestamp.
    cloud = HOME / "Library/CloudStorage"
    if cloud.is_dir():
        for entry in sorted(cloud.iterdir()):
            name = entry.name
            if not (name.startswith("GoogleDrive-") and " (" in name):
                continue
            if entry.is_symlink() or not entry.is_dir():
                continue
            cands.append(Candidate(
                category="ask-first", path=str(entry), bytes=size(str(entry)),
                reason="orphaned Drive copy (report only; may hold files the live Drive lacks)",
                tier="ask-first", op="report",
            ))
    # BotFleet update generations -- ask once a pending update exists.
    gens = HOME / "Library/Caches/BotFleet/updates"
    if gens.is_dir():
        entries = sorted(gens.iterdir(), key=lambda p: p.stat().st_mtime if p.exists() else 0, reverse=True)
        for g in entries[1:]:
            cands.append(Candidate(
                category="ask-first", path=str(g), bytes=size(str(g)),
                reason="BotFleet update generation (non-newest)", tier="ask-first", op="report",
            ))
    # Idle regenerable build output in main checkouts (report only): .build,
    # build, .next and dist trees with no file touched in 7 days and no open
    # files.  Main checkouts are never lanes, so the vacuum's lane logic never
    # sees them; the names mirror REGENERABLE_NAMES in scripts/vacuum/lanes.py.
    code = HOME / "Code"
    if code.is_dir():
        for repo in sorted(code.iterdir()):
            if repo.is_symlink() or not repo.is_dir() or not (repo / ".git").exists():
                continue
            for dirname in (".build", "build", ".next", "dist"):
                target = repo / dirname
                if target.is_symlink() or not target.is_dir():
                    continue
                if is_forbidden(str(target)) or has_keep_sentinel(str(target)):
                    continue
                if open_handles(str(target)):
                    continue
                # Fast path first: a recent file inside the cap proves activity
                # cheaply.  Only a quiet-looking tree pays for the uncapped
                # find probe, which catches a recent file hiding past the cap.
                if newest_file_age_min(str(target)) < IDLE_MIN_BUILD_OUTPUT:
                    continue
                if touched_since(str(target), IDLE_MIN_BUILD_OUTPUT / (24 * 60)):
                    continue
                cands.append(Candidate(
                    category="ask-first", path=str(target), bytes=size(str(target)),
                    reason=f"idle regenerable build output in {repo.name} (report only; rebuilds on demand)",
                    tier="ask-first", op="report",
                ))
    return cands


_DEV_CACHE_PATHS = (
    "Library/Caches/node-gyp",
    "Library/Caches/electron",
    "Library/Caches/electron-builder",
    "Library/Caches/deno",
    "Library/Caches/copilot",
    "Library/Caches/org.swift.swiftpm",
    "Library/Caches/ms-playwright",
    "Library/Caches/@mmx-agentelectron-updater",
    ".npm/_cacache",
    ".cache/uv",
    ".cache/pip",
    ".yarn/cache",
    "Library/pnpm/store",
)

# Not a dev cache and not ours to sweep.  `Library/Caches/BotFleet/updates`
# holds the update generations the ask-first inventory reports and never
# deletes; the catch-all below works on whole directories, so without this it
# would purge a pending update before BotFleet ever applied it.
_APP_CACHE_KEEP = (
    "Library/Caches/BotFleet",
)


def rule_app_caches() -> list[Candidate]:
    """Per-application cache directories that no other rule covered.

    The measured hog on this Mac was `~/Library/Caches/org.swift.swiftpm` at
    3.6 GB, with Codex (624 MB), pnpm (552 MB), antigravity (349 MB) and
    electron (248 MB) on top of it.  The old rule set named a handful of
    specific toolchain caches and nothing else, so a host whose space went
    into app caches got nothing back -- and the dev-caches rule that *did*
    name swiftpm could not act on it, because the per-path lsof check timed
    out under load and every cache read as in use.

    These are the same gates the other cache rules use: idle, no open
    handles, no keep sentinel, not forbidden, and big enough to be worth the
    delete.  Everything under ~/Library/Caches is rebuildable by its app.
    """
    cands: list[Candidate] = []
    roots: list[tuple[Path, str]] = [
        (HOME / "Library/Caches", "application cache"),
        (HOME / "Library/Application Support", "application support cache"),
        (HOME / "Library/Containers", "sandboxed container cache"),
        (HOME / "Library/Group Containers", "group container cache"),
    ]
    # Only the cache-shaped children of these trees.  Everything else in
    # Application Support is app state and stays untouched.  The names are
    # matched case-insensitively: this volume is case-insensitive, so "Cache"
    # and "cache" are the same directory and must not be counted twice.
    support_names = {"cache", "cacheddata", "code cache", "gpucache", "logs", "cachestorage"}
    for root, label in roots:
        if not root.is_dir():
            continue
        try:
            children = sorted(root.iterdir())
        except OSError:
            continue
        for child in children:
            if child.is_symlink() or not child.is_dir():
                continue
            try:
                if root.name == "Caches":
                    targets = [(child, label)]
                elif root.name == "Application Support":
                    targets = [(d, label) for d in child.iterdir()
                               if d.is_dir() and d.name.lower() in support_names]
                else:
                    targets = []
                    data = child / "Data"
                    cache_root = data / "Library" / "Caches"
                    if cache_root.is_dir():
                        targets.append((cache_root, label))
                    lib = data / "Library"
                    if lib.is_dir():
                        targets += [(d, label) for d in lib.iterdir()
                                    if d.is_dir() and d.name.lower() in support_names]
                for target, what in targets:
                    if not target.is_dir() or target.is_symlink():
                        continue
                    s = str(target)
                    if is_forbidden(s) or has_keep_sentinel(s):
                        continue
                    if any(s.endswith("/" + dp) or s == str(HOME / dp)
                           for dp in _DEV_CACHE_PATHS + _APP_CACHE_KEEP):
                        continue
                    if newest_file_age_min(s) < IDLE_MIN_OK:
                        continue
                    # newest_file_age_min stops after 4000 entries, so a big
                    # cache tree (Chrome, Slack, Electron are all past that)
                    # can hide a recent write past the cap and read as idle.
                    # touched_since answers on the FIRST recent file, and a
                    # failed look reads as touched: an unprovable tree is
                    # never called idle.
                    if touched_since(s, IDLE_MIN_OK / (24 * 60)):
                        continue
                    if open_handles(s):
                        continue
                    size = dir_bytes(s)
                    if size < 8 * 1024 * 1024:
                        continue
                    cands.append(Candidate(
                        category="app-caches", path=s, bytes=size,
                        reason=f"{what}, idle, no open handles",
                    ))
            except OSError as exc:
                # One unreadable directory must not cost the whole rule.  The
                # scan is the thing that has to survive a busy host.
                log(f"app-caches skipped {child}: {type(exc).__name__}: {exc}")
    return cands


_AGENT_HOMES = (".codex", ".claude", ".grok", ".minimax", ".cursor", ".config", ".gemini", ".opencode")
_AGENT_TRANSIENT = ("logs", "log", "tmp", "temp", "cache", "caches", "debug", "shell-snapshots")
_AGENT_HISTORY = ("sessions", "projects", "history", "conversations")


def _dirs_named(root: Path, names: tuple[str, ...]) -> list[Path]:
    """Directories under root whose name matches one of names.

    The match is case-insensitive because this volume is case-insensitive, so
    "Cache" and "cache" are the same directory.  Globbing both spellings
    found it twice and counted its size twice.
    """
    wanted = {n.lower() for n in names}
    try:
        children = list(root.iterdir())
    except OSError:
        return []
    return [c for c in children
            if not c.is_symlink() and c.is_dir() and c.name.lower() in wanted]


def _agent_transient_dirs(root: Path) -> list[Path]:
    """Transient directories under an agent home, one and two levels down."""
    wanted = {n.lower() for n in _AGENT_TRANSIENT}
    out: list[Path] = []
    try:
        children = [c for c in root.iterdir() if not c.is_symlink() and c.is_dir()]
    except OSError:
        return out
    for child in children:
        if child.name.lower() in wanted:
            out.append(child)
            continue
        try:
            grand = [g for g in child.iterdir() if not g.is_symlink() and g.is_dir()]
        except OSError:
            continue
        out += [g for g in grand if g.name.lower() in wanted]
    return out


def rule_agent_state() -> list[Candidate]:
    """Transient state left behind by the coding agents that run on this Mac.

    The agents are the fleet's own workers, and they write logs, scratch
    files and caches next to their state.  Those rebuild; the sessions and
    transcripts beside them do not, so the sessions are reported rather than
    deleted and only the transient parts are removed.
    """
    cands: list[Candidate] = []
    seen: set[tuple[int, int]] = set()

    def claim(path: Path) -> bool:
        """True when this path is not already claimed under another spelling."""
        try:
            st = os.stat(path)
        except OSError:
            return True
        key = (st.st_dev, st.st_ino)
        if key in seen:
            return False
        seen.add(key)
        return True

    for name in _AGENT_HOMES:
        root = HOME / name
        if not root.is_dir():
            continue
        for target in _agent_transient_dirs(root):
            s = str(target)
            if is_forbidden(s) or has_keep_sentinel(s):
                continue
            if not claim(target):
                continue
            if newest_file_age_min(s) < IDLE_MIN_OK or open_handles(s):
                continue
            size = dir_bytes(s)
            if size < 8 * 1024 * 1024:
                continue
            cands.append(Candidate(
                category="agent-state", path=s, bytes=size,
                reason="agent transient state, idle, no open handles",
            ))
    # The agent session transcripts are Jay's history, not cache.  Report them.
    for name in _AGENT_HOMES:
        root = HOME / name
        if not root.is_dir():
            continue
        for target in _dirs_named(root, _AGENT_HISTORY):
            s = str(target)
            if is_forbidden(s) or has_keep_sentinel(s):
                continue
            if not claim(target):
                continue
            size = dir_bytes(s)
            if size < 64 * 1024 * 1024:
                continue
            cands.append(Candidate(
                category="agent-state", path=s, bytes=size,
                reason="agent session history (report only; it is not cache)",
                tier="ask-first", op="report",
            ))
    return cands


RULES: dict[str, tuple[Callable[[], list[Candidate]], str]] = {
    "snapshots": (rule_snapshots, "APFS / Time Machine local snapshots"),
    "temp-scratch": (rule_temp_scratch, "Orphaned per-user temp scratch"),
    "app-staging": (rule_app_staging, "Extracted but unused app updaters"),
    "botfleet-rollback": (rule_botfleet_rollback, "Abandoned BotFleet update/rollback copies"),
    "dev-caches": (rule_dev_caches, "Package manager and toolchain caches"),
    "app-caches": (rule_app_caches, "Per-application cache directories"),
    "agent-state": (rule_agent_state, "Transient state left by coding agents"),
    "xcode-artifacts": (rule_xcode_artifacts, "DerivedData and device support"),
    "simulator-runtimes": (rule_simulator_runtimes, "iOS simulator runtimes"),
    "logs": (rule_unbounded_logs, "Unbounded logs (tail-truncated)"),
    "sqlite-wal": (rule_sqlite_wals, "Oversized SQLite WAL (checkpointed)"),
    "brew": (rule_brew, "Homebrew obsolete versions"),
    "ask-first": (rule_ask_first_inventory, "Ask-first inventory (report only)"),
}


# --------------------------------------------------------------------------
# Band
# --------------------------------------------------------------------------

def _read_cpu_pressures() -> tuple[float, float]:
    """Return (cpu_idle_pct, kernel_task_pct).

    Idle comes from `top -l 1`, which prints a CPU table with no command
    arguments, so this stays inside the never-bare-`ps` rule.  The format is
    "CPU usage: 40.39% user, 40.28% sys, 19.32% idle" -- the NUMBER precedes
    the label, so match "<pct>% idle" rather than reading the token after it.

    kernel_task is not in `top`'s CPU summary.  It is read from `ps -A -o
    pcpu=,comm=`, which prints only the executable name and never argv, so it
    cannot leak the API keys that bare `ps` would.

    Returns (0.0, 0.0) when a reading is unavailable.  An unknown value must
    NOT be read as thrash, so the caller treats a missing idle as "unknown"
    rather than "0% idle" -- see the guard in is_thrashing's caller.
    """
    out = _run(["/usr/bin/top", "-l", "1", "-n", "0"], timeout=15)
    idle = -1.0
    for line in out.splitlines():
        m = re.search(r"CPU usage:.*?([\d.]+)%\s*idle", line)
        if m:
            idle = float(m.group(1))
            break

    kernel = 0.0
    pout = _run(["/bin/ps", "-A", "-o", "pcpu=,comm="], timeout=15)
    for line in pout.splitlines():
        parts = line.split(None, 1)
        if len(parts) == 2 and parts[1].strip() == "kernel_task":
            try:
                kernel = float(parts[0])
            except ValueError:
                pass
            break

    # Unknown idle (-1) is reported as 100 so it never trips the thrash gate.
    return (idle if idle >= 0 else 100.0), kernel


def read_band() -> Band:
    free_gb = 0.0
    used_pct = 0.0
    out = _run(["/bin/df", "-k", "/System/Volumes/Data"], timeout=15)
    lines = out.splitlines()
    if len(lines) >= 2:
        parts = lines[1].split()
        try:
            free_gb = int(parts[3]) / (1024 * 1024)
            used_pct = int(parts[4].rstrip("%"))
        except (IndexError, ValueError):
            pass
    swap_pct = 0.0
    sout = _run(["/usr/sbin/sysctl", "-n", "vm.swapusage"], timeout=10)
    # `vm.swapusage` prints "total = ...M  used = ...M  free = ...M  (encrypted)".
    # total comes FIRST, so an order-sensitive regex silently reads 0 and the
    # swap gate never fires -- which would let the engine run the full tier
    # during exactly the episode it exists to protect.  Parse keys separately.
    total_m = used_m = None
    m_tot = re.search(r"\btotal\s*=\s*([\d.]+)M", sout)
    m_used = re.search(r"\bused\s*=\s*([\d.]+)M", sout)
    if m_tot:
        total_m = float(m_tot.group(1))
    if m_used:
        used_m = float(m_used.group(1))
    if total_m and total_m > 0:
        swap_pct = 100.0 * (used_m or 0.0) / total_m
    load1 = 0.0
    try:
        load1 = os.getloadavg()[0]
    except OSError:
        pass

    # load1 alone cannot tell real work from memory thrash: tasks blocked in
    # uninterruptible page-in count as running, so load1 lags.  Read CPU idle
    # and kernel_task alongside it.  Never bare `ps` -- argv on this Mac
    # carries live API keys; parse the `top -l 1` CPU table instead, which
    # prints no arguments.
    cpu_idle_pct, kernel_task_pct = _read_cpu_pressures()

    # Pressure shapes the work; it never shrinks it.  (Owner ruling
    # 2026-10-02.)  The only outcome that opens the expensive tier is real
    # space pressure, not a busy CPU.
    reasons = []
    if swap_pct >= SWAP_CRIT_PCT:
        reasons.append(f"swap {swap_pct:.0f}% >= {SWAP_CRIT_PCT:.0f}%")
    if load1 > LOAD_CRIT:
        reasons.append(f"load1 {load1:.0f} > {LOAD_CRIT:.0f}")

    thrashing = cpu_idle_pct < CHUNK_IDLE_LOW_PCT
    chunk_size = CHUNK_TARGETS
    pause = CHUNK_PAUSE_SEC
    if thrashing:
        # Smallest burst, longest pause.  Still cleaning.
        chunk_size, pause = 1, CHUNK_PAUSE_SEC * 4
    elif swap_pct >= SWAP_CRIT_PCT or load1 > CHUNK_LOAD_HIGH:
        chunk_size, pause = 2, CHUNK_PAUSE_SEC * 2

    return Band(
        disk_free_gb=free_gb, disk_used_pct=used_pct, swap_used_pct=swap_pct,
        load1=load1, cheap_only=bool(reasons), reasons=reasons,
        cpu_idle_pct=cpu_idle_pct, kernel_task_pct=kernel_task_pct,
        chunk_size=chunk_size, chunk_pause_sec=pause, throttling=thrashing,
    )


# --------------------------------------------------------------------------
# Driver
# --------------------------------------------------------------------------

def scan(cats: Sequence[str] | None) -> list[Candidate]:
    global _SCAN_BUDGET_EXHAUSTED
    _SCAN_BUDGET_EXHAUSTED = False
    out: list[Candidate] = []
    seen: set[tuple[str, str]] = set()
    seen_inodes: set[tuple[int, int, str]] = set()
    for name, (fn, _desc) in RULES.items():
        if cats and name not in cats:
            continue
        if scan_budget_left() <= 0:
            if _SCAN_DEADLINE is not None:
                _SCAN_BUDGET_EXHAUSTED = True
            break
        try:
            found = fn()
        except Exception as exc:  # a broken rule must not kill the scan
            log(f"rule {name} failed: {type(exc).__name__}: {exc}")
            found = []
        for c in found:
            # Two rules can name the same path.  Delete it once.  The identity
            # is the inode, not the spelling: this volume is case-insensitive,
            # so "Cache" and "cache" are one directory and counting it twice
            # inflated the total and would have deleted it twice.
            key = (c.path, c.op)
            if key in seen:
                continue
            try:
                st = os.stat(c.path)
                ino = (st.st_dev, st.st_ino, c.op)
                if ino in seen_inodes:
                    continue
                seen_inodes.add(ino)
            except OSError:
                pass
            seen.add(key)
            out.append(c)
        if _SCAN_DEADLINE is not None and scan_budget_left() <= 0:
            _SCAN_BUDGET_EXHAUSTED = True
            break
    return out


_KEEP_MIB_RE = re.compile(r"(\d+)M")


def apply_candidate(c: Candidate) -> None:
    if c.tier == "ask-first" or c.op == "report":
        return
    try:
        if c.op == "delete":
            freed, err = apply_delete(c.path, known_bytes=c.bytes)
        elif c.op == "truncate":
            keep = _KEEP_MIB_RE.search(c.detail or "")
            freed, err = apply_truncate(c.path, keep_mib=int(keep.group(1)) if keep else 16)
        elif c.op == "wal-checkpoint":
            freed, err = apply_wal_checkpoint(c.path)
        elif c.op == "snapshot-delete":
            freed, err = apply_snapshot_delete(c.path.split(":", 1)[1])
        elif c.op == "brew-cleanup":
            _run(["/opt/homebrew/bin/brew", "cleanup", "--prune=all"], timeout=op_timeout(600))
            freed, err = 0, ""
        else:
            return
    except Exception as exc:
        c.error = f"{type(exc).__name__}: {exc}"
        return
    c.applied = not err
    c.error = err
    if freed and not c.error:
        c.bytes = max(c.bytes, freed) if c.op == "delete" else freed


def is_light(c: Candidate) -> bool:
    """A file or small tree that goes in one quick delete or truncate.  Everything else is heavy."""
    return c.op in ("delete", "truncate") and c.bytes < LIGHT_CANDIDATE_BYTES


def apply_order(c: Candidate) -> tuple[int, int]:
    """Snapshots first (the biggest reclaim, and a few metadata calls), then biggest first, so a run that stops
    on its budget has done the most valuable part."""
    return (0 if c.op == "snapshot-delete" else 1, -c.bytes)


def plan_chunks(items: Sequence[Candidate], size: int) -> list[list[Candidate]]:
    """Cut the work into chunks of `size` slots.  A heavy candidate takes a whole slot and LIGHT_PER_SLOT light
    ones share one, so the number of chunks follows the weight of the work and never its file count.  The order
    of `items` is kept."""
    capacity = max(1, size) * LIGHT_PER_SLOT
    chunks: list[list[Candidate]] = []
    current: list[Candidate] = []
    used = 0
    for c in items:
        weight = 1 if is_light(c) else LIGHT_PER_SLOT
        if current and used + weight > capacity:
            chunks.append(current)
            current, used = [], 0
        current.append(c)
        used += weight
    if current:
        chunks.append(current)
    return chunks


def main(argv: Sequence[str] | None = None) -> int:
    p = argparse.ArgumentParser(prog="hoghunter-clean", description="Hog Hunter reclaim engine")
    p.add_argument("--scan", action="store_true", help="read-only (default)")
    p.add_argument("--clean", action="store_true", help="apply the safe tier")
    p.add_argument("--band", choices=("cheap", "full"), default="cheap",
                   help="cheap=only the safe tier (default); full=also semi-safe")
    p.add_argument("--categories", default="", help="comma-separated subset")
    p.add_argument("--min-free-gb", type=float, default=0.0,
                   help="skip the safe tier entirely above this much free space")
    p.add_argument("--json", action="store_true", help="machine-readable output")
    p.add_argument("--policy", action="store_true", help="print the policy and exit")
    p.add_argument("--list", action="store_true", help="list rule names and exit")
    p.add_argument("--size-ask-first", action="store_true",
                   help="also walk the ask-first trees to size them (slow under load)")
    p.add_argument("--budget-sec", type=float, default=0.0,
                   help="stop starting work after this many seconds and report what is left "
                        "(0 = no limit); the next run rescans and carries on")
    p.add_argument("--cleanmymac", action="store_true",
                   help="after this engine's own work, also run the CleanMyMac CLI "
                        "sweeps (clean junk --force, optimize purgeable) when installed; "
                        "never invoked without this flag")
    p.add_argument("--clean-ios27", action="store_true",
                   help="also clean iOS 27 simulator runtimes (preserved by default)")
    p.add_argument("--version", action="store_true")
    args = p.parse_args(argv)

    global SIZE_ASK_FIRST, CLEAN_IOS27
    SIZE_ASK_FIRST = args.size_ask_first
    CLEAN_IOS27 = args.clean_ios27 or os.environ.get("HOGHUNTER_CLEAN_IOS27") == "1"
    started = time.monotonic()
    set_budget(args.budget_sec)

    if args.version:
        print(f"hoghunter-clean {VERSION}")
        return 0
    if args.list:
        for name, (_fn, desc) in RULES.items():
            print(f"{name:22s} {desc}")
        return 0
    if args.policy:
        print(POLICY_PATH.read_text() if POLICY_PATH.is_file() else "{}")
        return 0

    cats = [c.strip() for c in args.categories.split(",") if c.strip()]
    for c in cats:
        if c not in RULES:
            log(f"unknown category {c!r}; known: {', '.join(RULES)}")
            return 2

    band = read_band()
    cands = scan(cats or None)

    # The safe tier ALWAYS runs.  Pressure no longer removes it.  (Owner
    # ruling 2026-10-02: "swap high should mean that you do the same stuff you
    # otherwise would but just divide the tasks into maybe 2-4 separate smaller
    # tasks".)  Pressure now selects the CHUNK SIZE instead -- see the
    # batched apply loop below.
    allowed = {"safe"}
    if args.band == "full":
        # semi-safe is metadata work (tmutil deletelocalsnapshots) plus small
        # deletes.  It is the largest reclaim available on this Mac, so
        # pressure throttles its pacing but must not gate it shut.  The old
        # `if not band.cheap_only` made semi-safe unreachable whenever load
        # exceeded 40 -- which on this host is almost always.
        allowed.add("semi-safe")
        if band.disk_band in ("critical", "acute"):
            # Bulk I/O deletes (simulator runtimes, device support) are the
            # biggest single wins -- 18.55 GB measured 2026-09-27 -- but they
            # are also the operations that thrash the disk.  This stays gated
            # on real SPACE pressure, which is the honest signal, and is no
            # longer additionally gated on a busy CPU.
            allowed.add("expensive")

    log(f"band={args.band} pressure={band.pressure_label} "
        f"({band.cpu_idle_pct:.0f}% idle, load1 {band.load1:.0f}, "
        f"swap {band.swap_used_pct:.0f}%) -> chunks of {band.chunk_size}, "
        f"{band.chunk_pause_sec:.0f}s apart; tiers {sorted(allowed)}")

    if args.clean and band.disk_free_gb >= args.min_free_gb > 0:
        log(f"free {band.disk_free_gb:.1f}G >= --min-free-gb {args.min_free_gb:.1f}; skipping")
        return 0

    actionable = [c for c in cands if c.tier in allowed]
    # Two different things end a run early, and the report must not conflate
    # them.  `scan_truncated` means the SCAN hit its own share of the budget
    # and there may be more to find than this run listed.  `budget_spent`
    # means the whole budget ran out, so some candidates were never started.
    # Either one means the run did not finish everything, which is what
    # `budget_exhausted` reports.
    scan_truncated = _SCAN_BUDGET_EXHAUSTED
    budget_spent = False
    after_band = None
    attempted = 0
    if args.clean:
        # CHUNKED APPLY.  Under pressure the work is split into small batches
        # with a pause and a re-read between them, so the host gets breathing
        # room while deletes land.  The SCOPE is unchanged -- same candidates,
        # same tiers -- only the burst size shrinks.  (Owner ruling
        # 2026-10-02.)  A chunk is a slot of work, not a file (plan_chunks),
        # and a run with a budget stops starting work when the budget is
        # spent: the rest is found again by the next scan.
        ordered = sorted(actionable, key=apply_order)
        chunks = plan_chunks(ordered, band.chunk_size)
        for n, batch in enumerate(chunks, 1):
            if budget_left() <= 0:
                budget_spent = True
                break
            applied_here = 0
            for c in batch:
                left = budget_left()
                if left <= 0:
                    budget_spent = True
                    break
                if not is_light(c) and left < MIN_HEAVY_START_SEC:
                    budget_spent = True  # too little time to start this one; a light item may still fit
                    continue
                apply_candidate(c)
                attempted += 1
                applied_here += 1
            log(f"chunk {n}/{len(chunks)}: applied {applied_here} "
                f"({len(ordered)} total)")
            if budget_spent:
                break
            if n < len(chunks) and band.chunk_pause_sec > 0:
                time.sleep(min(band.chunk_pause_sec, budget_left()))
                if budget_left() <= 0:
                    budget_spent = True
                    break
                mid = read_band()
                log(f"  after chunk: load1 {mid.load1:.0f}, "
                    f"{mid.cpu_idle_pct:.0f}% idle, "
                    f"swap {mid.swap_used_pct:.0f}%, {mid.pressure_label}")
        if budget_spent:
            log(f"budget of {args.budget_sec:.0f}s spent: {attempted} of {len(ordered)} "
                f"applied, {len(ordered) - attempted} left for the next run")
        if scan_truncated:
            log(f"scan stopped at {SCAN_BUDGET_FRACTION:.0%} of the budget, leaving the "
                f"rest for the deletes; there may be more to find than this run listed")
        # Snapshots report zero bytes by nature, so trust df, not the tally.
        if budget_left() > 0:
            after = read_band()
            after_band = after
            snapshot_delta = (after.disk_free_gb - band.disk_free_gb) * 1024
            if snapshot_delta > 512:
                log(f"disk free increased by {snapshot_delta:.0f}M during cleanup (df-verified)")

    budget_exhausted = scan_truncated or budget_spent
    # The MEASURED change in free space.  `applied_bytes` above is the size the
    # scan estimated before each delete; it is not proof that the bytes came
    # back.  A delete can free nothing on disk (the file is still open
    # elsewhere) and the host can spend what was freed in the same minute
    # (swap churn, log writes, rebuilds).  df is the only number that cannot
    # lie, so the report carries it next to the estimate.  None means the run
    # spent its budget before it could measure, which is not the same as
    # "freed nothing".
    disk_free_delta_gb = (round(after_band.disk_free_gb - band.disk_free_gb, 3)
                          if after_band is not None else None)

    cleanmymac_report: dict = {
        "requested": bool(args.cleanmymac),
        "installed": shutil.which("cleanmymac") is not None,
        "ran": False,
        "commands": [],
        "skipped": None,
    }
    if args.cleanmymac:
        if args.clean:
            run_cleanmymac_cli(cleanmymac_report, args.budget_sec)
        else:
            cleanmymac_report["skipped"] = "scan mode (nothing applied)"
            log("scan mode: CleanMyMac sweeps reported, not run (needs --clean --cleanmymac)")

    if args.json:
        print(json.dumps({
            "version": VERSION,
            "band": band.as_dict(),
            "mode": "clean" if args.clean else "scan",
            "tiers_applied": sorted(allowed),
            "candidates": [c.as_dict() for c in cands],
            "reclaimable_mib": round(
                sum(c.bytes for c in cands if c.tier in allowed) / (1024 * 1024), 1),
            "applied_mib": round(sum(c.bytes for c in actionable if c.applied) / (1024 * 1024), 1),
            # Added with --budget-sec.  The Robotic Vacuum reads these to report real bytes and a partial run.
            "applied_bytes": sum(c.bytes for c in actionable if c.applied),
            "applied_count": sum(1 for c in actionable if c.applied),
            "failed_count": sum(1 for c in actionable if c.error),
            "actionable_count": len(actionable),
            "budget_exhausted": budget_exhausted,
            # `scan_truncated` is the precise reason a run stopped early: the
            # scan hit its own share of the budget and there may be more to
            # find.  `budget_spent` is the other reason: the whole budget ran
            # out.  `budget_exhausted` is either one.
            "scan_truncated": scan_truncated,
            "budget_spent": budget_spent,
            # The measured change in free space, next to the estimate above.
            "disk_free_gb_before": round(band.disk_free_gb, 3),
            "disk_free_gb_after": (round(after_band.disk_free_gb, 3)
                                   if after_band is not None else None),
            "disk_free_delta_gb": disk_free_delta_gb,
            "remaining_count": (len(actionable) - attempted) if args.clean else 0,
            "elapsed_sec": round(time.monotonic() - started, 1),
            "cleanmymac": cleanmymac_report,
        }, indent=2))
        return 0

    # Human report
    if not args.json:
        print(f"hoghunter-clean {VERSION} — {'CLEAN' if args.clean else 'SCAN'}")
        print(f"disk {band.disk_free_gb:.1f}G free ({band.disk_band}), "
              f"swap {band.swap_used_pct:.0f}%, load1 {band.load1:.0f}"
              + (f"  [pressure: {band.pressure_label}"
                 f"{', ' + ', '.join(band.reasons) if band.reasons else ''}]"))
        print(f"tiers applied: {', '.join(sorted(allowed))}\n")
        if args.clean:
            estimate = sum(c.bytes for c in actionable if c.applied)
            print(f"applied {sum(1 for c in actionable if c.applied)} items, "
                  f"estimated {estimate / 1e9:.2f} GB")
            if disk_free_delta_gb is None:
                print("free space: not measured (the budget ran out before the final reading)")
            else:
                print(f"free space: {band.disk_free_gb:.2f} GB -> "
                      f"{after_band.disk_free_gb:.2f} GB "
                      f"({disk_free_delta_gb:+.2f} GB measured by df)")
        if cleanmymac_report["requested"]:
            if cleanmymac_report["ran"]:
                exits = ",".join(str(c.get("exit")) for c in cleanmymac_report["commands"])
                print(f"CleanMyMac CLI sweeps ran (exits {exits}).")
            else:
                print(f"CleanMyMac CLI sweeps skipped: {cleanmymac_report['skipped']}.")
        if not cands:
            print("nothing reclaimable.")
        by_cat: dict[str, list[Candidate]] = {}
        for c in cands:
            by_cat.setdefault(c.category, []).append(c)
        for cat in sorted(by_cat):
            items = sorted(by_cat[cat], key=lambda c: -c.bytes)
            total = sum(c.bytes for c in items) / (1024 * 1024)
            tier = items[0].tier
            marker = "ASK" if tier == "ask-first" else ("SEMI" if tier == "semi-safe" else "safe")
            print(f"[{marker}] {cat} — {len(items)} items, {total:.1f}M")
            for c in items[:6]:
                flag = "x" if c.applied else ("E" if c.error else ("R" if c.tier == "ask-first" else " "))
                print(f"    {flag} {c.mib:9.1f}M  {report_path(c.path)}")
                if c.error:
                    print(f"        error: {report_path(c.error)}")
            if len(items) > 6:
                print(f"      ... and {len(items) - 6} more")
    return 0


if __name__ == "__main__":
    sys.exit(main())
