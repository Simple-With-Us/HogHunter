<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Hog Hunter connects to the Hog Hunter iPhone companion on this Wi-Fi to share activity telemetry and support remote controls when enabled.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_hoghunter._tcp</string>
	</array>
	<!-- Sentry DSN, injected at build time from the SENTRY_DSN environment.
	     Empty in local and CI builds, which keeps SentryTelemetry a no-op. -->
	<key>SentryDSN</key>
	<string>$(SENTRY_DSN)</string>
	<!-- Sparkle 2 automatic updater feed and verification key -->
	<key>SUFeedURL</key>
	<string>https://github.com/Simple-With-Us/HogHunter/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>8nQ6+N6opPFZYkZUgMtyvfbqZH92Kpw3haG/6trehuE=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUAutomaticallyUpdate</key>
	<true/>
	<key>SUAllowsAutomaticUpdates</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>3600</integer>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
</dict>
</plist>
